<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>dev.concord</groupId>
    <artifactId>concord-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Concord</name>
    <description>Payment state consistency engine</description>

    <modules>
        <module>gateway-simulator</module>
        <module>ingestion</module>
        <module>state-engine</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jqwik.version>1.9.3</jqwik.version>
        <aws-sdk.version>2.55.12</aws-sdk.version>
        <aws-lambda-core.version>1.4.0</aws-lambda-core.version>
        <aws-lambda-events.version>3.16.1</aws-lambda-events.version>
        <dynamodb-local.version>2.6.1</dynamodb-local.version>
        <elasticmq.version>1.7.1</elasticmq.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
